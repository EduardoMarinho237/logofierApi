# ===== Configuração =====
# Copie este arquivo para .env e preencha as variáveis.
# NUNCA commite o .env com segredos reais.

# Banco de dados. Local: sqlite:///./logofier.db  — Produção/CI: postgresql://user:pass@host:5432/logofier
DATABASE_URL=sqlite:///./logofier.db

# Auth — OBRIGATÓRIO, mínimo 32 caracteres, sem placeholders.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_WITH_A_RANDOM_32_PLUS_CHARACTER_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
REFRESH_TOKEN_EXPIRATION_DAYS=14

# Origem do frontend (CORS)
CORS_ORIGINS=["http://localhost:3000"]

# ------------------------------------------------------------------
# Cloudflare R2 (OPCIONAL - só para produção/deploy)
# Deixe TODOS os campos R2 VAZIOS para usar armazenamento local.
# ------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=logofier-files
R2_PUBLIC_URL=

# Pasta onde os arquivos serão salvos localmente (quando R2 está vazio)
LOCAL_STORAGE_DIR=./local_storage

# ------------------------------------------------------------------
# Docker compose (Postgres) — usados pelo docker-compose.yml
# O compose monta DATABASE_URL a partir destes valores (ignora o DATABASE_URL acima).
# ------------------------------------------------------------------
POSTGRES_USER=logofier
POSTGRES_PASSWORD=
POSTGRES_DB=logofier

# Limite de tentativas de login por minuto (slowapi)
RATE_LIMIT_LOGIN=5/minute